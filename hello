      const m=S.me;ctx.strokeStyle='#fff';ctx.lineWidth=3;ctx.setLineDash([8,8]);
      ctx.beginPath();ctx.moveTo(m.x,m.y);ctx.lineTo(m.x+Math.cos(S.ang)*120,m.y+Math.sin(S.ang)*120);ctx.stroke();ctx.setLineDash([])}
  }
  (S.parts||[]).forEach(p=>{ctx.globalAlpha=Math.max(0,p.t/p.m);ctx.fillStyle=p.c;ctx.beginPath();ctx.arc(p.x,p.y,p.s*(.4+.6*p.t/p.m),0,7);ctx.fill()});
  (S.fx||[]).forEach(f=>{ctx.globalAlpha=Math.max(0,f.t/f.m);ctx.lineWidth=4;ctx.strokeStyle=f.c||'#ffe66d';ctx.beginPath();
    if(f.type==='ring')ctx.arc(f.x,f.y,f.r*(1.3-f.t/f.m*.6),0,7);
    else{ctx.moveTo(f.x,f.y);for(let k=1;k<=6;k++){const u=k/6,j=k<6?(Math.random()-.5)*26:0;ctx.lineTo(f.x+(f.x2-f.x)*u+j,f.y+(f.y2-f.y)*u+j)}}
    ctx.stroke()});
  ctx.globalAlpha=1;
  (S.nums||[]).forEach(n=>{ctx.globalAlpha=Math.min(1,n.t/n.m*1.6);ctx.font=(n.big?'900 22px':'800 15px')+' system-ui';ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.lineWidth=4;ctx.strokeStyle='#000d';ctx.strokeText(n.txt,n.x,n.y);ctx.fillStyle=n.c;ctx.fillText(n.txt,n.x,n.y)});
  ctx.globalAlpha=1;
  if(S.phase==='pick'){ctx.fillStyle='#fff9';ctx.font='600 18px system-ui';ctx.textAlign='center';ctx.fillText('Pick a ball below',W/2,W/2)}
  ctx.restore();
}
let last=performance.now();
function loop(n){
  let dt=Math.min(.033,(n-last)/1000);last=n;
  if(S.phase==='fight'&&!S.fin){
    if(S.online){S.acc=(S.acc||0)+dt;let n=0;while(S.acc>=1/180&&n<12&&S.phase==='fight'&&!S.fin){step(1/180);S.acc-=1/180;n++}if(S.acc>.2)S.acc=0;
      if(S.host&&R&&S.phase==='fight'&&S.t-(S.lsn||0)>=.3){S.lsn=S.t;S.skn=(S.skn||0)+1;R.presence({sn:{t:+S.t.toFixed(3),c:+S.pairCd.toFixed(3),a:pk(S.p1),b:pk(S.p2)},k:S.skn,rdk:S.rd})}}
    else if(S.hitstop>0)S.hitstop-=dt;else{const sp=S.speed||1,k=3*sp;for(let i=0;i<k&&S.phase==='fight';i++)step(dt*sp/k)}}
  fxStep(dt);draw();requestAnimationFrame(loop);
}
const CLICK=10;let cT=0;
function earn(n,manual){
  if(!hasAuto())return;
  S.coins+=n;$('coins').textContent=S.coins;
  const r=$('clickBtn').getBoundingClientRect(),f=document.createElement('div');f.className='fl';f.textContent='+$'+n;
  f.style.left=(r.left+Math.random()*r.width*.6)+'px';f.style.top=(r.top-6)+'px';document.body.appendChild(f);setTimeout(()=>f.remove(),700);
  if(manual)snd(700+Math.random()*200,.04,'square',.04);
  if(!cT)cT=setTimeout(()=>{cT=0;save();ui()},400)}
$('clickBtn').addEventListener('pointerdown',e=>{e.preventDefault();earn(CLICK,true)});
$('clickBtn').addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();earn(CLICK,true)}});
startMatch();requestAnimationFrame(loop);
</script></body></html>
